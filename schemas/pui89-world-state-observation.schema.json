{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pui89.github.io/schemas/pui89-world-state-observation.schema.json",
  "title": "PUI89 World-State Observation",
  "type": "object",
  "required": ["observation_id", "entity_id", "attribute", "value", "observed_at", "source_id", "modality", "evidence_kind", "quality"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "attribute": {"type": "string", "minLength": 1},
    "value": {},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_id": {"type": "string", "minLength": 1},
    "modality": {"enum": ["rgb", "depth", "lidar", "thermal", "audio", "chemical_sensor", "environmental", "operator", "simulation", "other"]},
    "evidence_kind": {"enum": ["observed", "inferred", "synthetic", "derived", "unknown"]},
    "quality": {"enum": ["valid", "degraded", "stale", "missing", "conflicting", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
