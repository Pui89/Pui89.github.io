{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pui89.github.io/schemas/pui89/world-state.schema.json",
  "title": "PUI89 WorldState",
  "type": "object",
  "x-pui89-contract-version": "0.1.0-draft",
  "additionalProperties": false,
  "properties": {
    "world_state_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object"
    },
    "observation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "reason"
      ],
      "additionalProperties": false
    },
    "known": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "world_state_id",
    "timestamp",
    "frame_id",
    "state",
    "observation_refs",
    "freshness",
    "uncertainty",
    "limitations"
  ]
}
